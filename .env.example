# Copy this file to .env.local and fill in the values from YOUR portfolio
# Supabase project (Project Settings -> API). Never commit .env.local.
#
# Only the public anon/publishable key belongs here. NEVER put the
# service-role key in any VITE_ variable: those are bundled into the browser.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public URL of the deployed site, no trailing slash (e.g. https://mayanksingh.dev).
# Used at build time for sitemap.xml, canonical URL and link-preview image.
# Leave empty until the domain is known.
VITE_SITE_URL=
